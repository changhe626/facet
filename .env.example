# ==============================
# Facet Environment Configuration
# ==============================
# Copy this file to .env and fill in your values.
# Used by: docker-compose.yml, backend config.yaml

# --- PostgreSQL ---
# Used by docker-compose to set up the database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=facet_secret
POSTGRES_DB=postgres

# Used by the backend to connect (docker-compose overrides this)
POSTGRES_DSN=postgres://postgres:facet_secret@localhost:5432/postgres?sslmode=disable&search_path=facet

# --- Redis ---
# Used by docker-compose (command flag) and backend
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=facet_secret
REDIS_DB=0

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRES_IN_HOURS=24

# --- Logger ---
LOGGER_LEVEL=debug
